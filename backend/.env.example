# Local development. In production these are Hugging Face Space secrets/variables.
NODE_ENV=development
PORT=7860
CORS_ORIGINS=http://localhost:5173

# Option A: Supabase (same as production)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Option B: fully local. Postgres with supabase/schema.sql applied, files on disk.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/heychat
# LOCAL_STORAGE_DIR=./.data/media

# Optional. If unset, signing keys are derived (HKDF) from SUPABASE_SERVICE_ROLE_KEY.
# APP_SECRET=at-least-32-random-characters
